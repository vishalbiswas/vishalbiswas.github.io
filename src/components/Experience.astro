---

<ol class="mb-3 grid gap-3 sm:grid-cols-2 2xl:grid-cols-3">
  {
    experiences.map((exp, i) => (
      <li>
        <CompanyEl company={exp.company} sequenceNumber={i + 1} />
      </li>
    ))
  }
</ol>
<H2>Projects</H2>
{
  experiences
    .flatMap((exp) => exp.projects)
    .map((project, i) => <ProjectEl project={project} sequenceNumber={i + 1} />)
}
