---
import ListItemWithIcon from "./ListItemWithIcon.astro";
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import { faPhone, faInbox } from "@fortawesome/free-solid-svg-icons";
import { faLinkedin } from "@fortawesome/free-brands-svg-icons";
import { faGithub } from "@fortawesome/free-brands-svg-icons";

library.add(faPhone, faInbox, faLinkedin, faGithub);
const githubIcon = icon({ prefix: "fab", iconName: "github" });
const linkedinIcon = icon({ prefix: "fab", iconName: "linkedin" });
const inboxIcon = icon({ prefix: "fas", iconName: "inbox" });
const phoneIcon = icon({ prefix: "fas", iconName: "phone" });

const {class: classes} = Astro.props
---

<div class="border border-gray-500 rounded-sm p-3 flex flex-col items-start justify-between" class:list={classes}>
  <ListItemWithIcon
    ><a href="tel:+918286668051"
      ><Fragment set:html={phoneIcon.html} />828 666 8051</a
    ></ListItemWithIcon
  >
  <ListItemWithIcon
    ><a href="mailto:vshlbiswas@ymail.com"
      ><Fragment set:html={inboxIcon.html} />vshlbiswas@ymail.com</a
    ></ListItemWithIcon
  >
  <div class="flex">
    <ListItemWithIcon
      ><a href="https://www.linkedin.com/in/vishalbiswas"
        ><Fragment set:html={linkedinIcon.html} />/vishalbiswas</a
      ></ListItemWithIcon
    >
    <ListItemWithIcon
      ><a href="https://www.github.com/vishalbiswas"
        ><Fragment set:html={githubIcon.html} />/vishalbiswas</a
      ></ListItemWithIcon
    >
  </div>
</div>
<style is:global>
  .svg-inline--fa {
    display: inline-block;
    height: 1em;
    overflow: visible;
    vertical-align: -0.125em;
    box-sizing: content-box;
    margin-right: 0.333em;
  }
</style>
