---
import { Font } from "astro:assets";
import '../styles/global.css'
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Vishal Biswas, Senior Software Engineer" />
		<meta name="og:title" content="Vishal Biswas" />
		<meta name="og:image" content="/src/assets/profile_pic.jpg" />
		<meta name="og:description" content="Senior Software Engineer with 8+ years of experience building full stack applications" />
		<title>Vishal Biswas</title>
		<Font cssVariable="--font-aleo" preload />
	</head>
	<body class="font-serif">
		<div class="container mx-auto p-3">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		/* margin: 0; */
		width: 100%;
		height: 100%;
	}

	@media print {
		@page {
			size: A4;
			margin: 1in !important;
		}
	}
</style>
